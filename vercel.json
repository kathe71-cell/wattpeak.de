{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/rechner-embed",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *;"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/anlagenvergleich",
      "destination": "/anlagen-vergleich",
      "permanent": true
    },
    {
      "source": "/system-decoder",
      "destination": "/anlagen-vergleich",
      "permanent": true
    },
    {
      "source": "/decoder",
      "destination": "/anlagen-vergleich",
      "permanent": true
    },
    {
      "source": "/katalog",
      "destination": "/hardware-katalog",
      "permanent": true
    },
    {
      "source": "/hardware",
      "destination": "/hardware-katalog",
      "permanent": true
    },
    {
      "source": "/rechner",
      "destination": "/ertragsrechner",
      "permanent": true
    },
    {
      "source": "/pvdachziegel",
      "destination": "/solardachziegel",
      "permanent": true
    },
    {
      "source": "/pvziegel",
      "destination": "/solardachziegel",
      "permanent": true
    },
    {
      "source": "/pvkomplettset",
      "destination": "/komplettsets",
      "permanent": true
    },
    {
      "source": "/pv-komplettset",
      "destination": "/komplettsets",
      "permanent": true
    },
    {
      "source": "/solarkomplettset",
      "destination": "/komplettsets",
      "permanent": true
    },
    {
      "source": "/balkonsolarset",
      "destination": "/komplettsets",
      "permanent": true
    },
    {
      "source": "/solarebaupflicht",
      "destination": "/solarpflicht",
      "permanent": true
    },
    {
      "source": "/solarspitzengesetz",
      "destination": "/solarpflicht",
      "permanent": true
    },
    {
      "source": "/solarreform",
      "destination": "/solarpflicht",
      "permanent": true
    },
    {
      "source": "/solarfoerderprogramm",
      "destination": "/solarpflicht",
      "permanent": true
    },
    {
      "source": "/balkonspeicher",
      "destination": "/balkonkraftwerk-speicher",
      "permanent": true
    },
    {
      "source": "/wechselrichter",
      "destination": "/wechselrichter-vergleich",
