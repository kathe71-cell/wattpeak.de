    },
    {
      "source": "/mikrowechselrichter",
      "destination": "/wechselrichter-vergleich",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!ads\\.txt|robots\\.txt|sitemap\\.xml|feed\\.xml|llms\\.txt|og-image\\.png|favicon\\.svg|assets/.*).*)",
      "destination": "/index.html"
    }
  ]
}